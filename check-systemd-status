# Standard modules
import copy
import json
import logging
import os
from shlex import quote
from subprocess import PIPE, Popen

# Own modules
from monitoring import DirectoryOptionAction, LogFileOptionAction, MonitoringPlugin
from monitoring import pp

__version__ = "0.1.0"

LOG = logging.getLogger(__name__)


# =============================================================================
class CheckSystemdStatusPlugin(MonitoringPlugin):
    """A monitoring plugin for evaluating the systemctl status."""

    # -------------------------------------------------------------------------
    def __init__(self):
        """Initialize the CheckSystemdStatusPlugin object."""
        desc = "Evaluating the systemctl status."
        self.timeout = 10

        super(CheckSystemdStatusPlugin, self).__init__(version=__version__, description=desc)

        self.status_msg = "Status of systemctl is UNKNOWN."

    # -------------------------------------------------------------------------
    def post_init(self):
        """Post initialization tasks."""
        self.timeout = 10

        super(CheckSystemdStatusPlugin, self).post_init()

        self.init_logparser()
        self.initialized = True

    # -------------------------------------------------------------------------
    def run(self):
        """Execute the main actions of the application."""
        LOG.debug("I'm walking, yes indeed, I'm walking....")

        cmd = ["/usr/bin/systemctl", "is-system-running"]

        retcode, stdout, stderr = self.execute(*cmd)

        system_status = stdout.strip().lower()

        if system_status == "running":
            self.status = self.status_ok
        elif system_status in ("initializing", "starting", "maintenance", "degraded"):
            self.status = self.status_warning
        elif system_status in ("stopping", "offline"):
            self.status = self.status_critical
        else:
            self.status = self.status_unknown

        failed_units = []
        if self.status != self.status_ok:
            cmd = ["/usr/bin/systemctl", "list-units", "--failed", "--output=json"]
            retcode, stdout, stderr = self.execute(*cmd)

            failed_units = json.loads(stdout)
            if self.verbose > 1:
                LOG.debug("Failed units:" + "\n" + pp(failed_units))
            self.status_msg = (
                f"According to systemd, the overall state of the system is [{system_status}]." 
            )

            if failed_units:
                first = failed_units[0]
                keys = []
                keys_uc = {}
                max_length = []
                for key in first.keys():
                    keys.append[key)
                    max_length[key] = len(key)
                    keys_uc[key] = key.upper()

                for unit in failed_units:
                    for key in keys:
                        if key in unit:
                            if len(unit[key]) > max_length[key]:
                                max_length[key] = len(unit[key])

                tpl_tokens = []
                for key in keys:
                    token = "{{{key}:<{max_length[ke}}}"
                    tpl_tokens.append(token)
                template = " ".join(tpl_tokens)

                self.status_msg += template.format(**keys_uc) + "\n"
                for unit in failed_units:
                    self.status_msg += template.format(**unit)
    
    # -------------------------------------------------------------------------
    def execute(*cmd):
        """Execute the given command."""
        cmd_str = " ".join((quote(x) for x in cmd[0]))
        LOG.debug(_("Executing: {}").format(cmd_str))

        process = None
        stdout = None
        stderr = None
        retcode = None

        try:
            process = Popen(*cmd)

            if self.verbose > 0:
                LOG.debug(_("PID of process: {}").format(process.pid))
            try:
                stdout, stderr = process.communicate(input=None, timeout=self.timeout)
            except Exception as e:
                if self.verbose > 2:
                    LOG.debug("{c} happened, killing process: {e}".format(
                        c=e.__class__.__name__, e=e))
                process.poll()
                if process.returncode is None:
                    process.kill()
                process.wait()
                raise

            retcode = process.poll()

        finally:
            if process:
                if process.stdout:
                    process.stdout.close()
                if process.stderr:
                    process.stderr.close()
                if process.stdin:
                    try:
                        process.stdin.close()
                    finally:
                        pass

        return (retcode, stdout, stderr)


