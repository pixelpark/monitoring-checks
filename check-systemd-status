from __future__ import print_function

# Standard modules
import copy
import json
import logging
import os
from shlex import quote
from subprocess import PIPE, Popen

# Own modules
from monitoring import DirectoryOptionAction, LogFileOptionAction, MonitoringPlugin
from monitoring import pp

__version__ = "0.3.0"

LOG = logging.getLogger(__name__)


# =============================================================================
class CheckSystemdStatusPlugin(MonitoringPlugin):
    """A monitoring plugin for evaluating the systemctl status."""

    # -------------------------------------------------------------------------
    def __init__(self):
        """Initialize the CheckSystemdStatusPlugin object."""
        desc = "Evaluating the systemctl status."

        super(CheckSystemdStatusPlugin, self).__init__(version=__version__, description=desc)

        self.status_msg = "Status of systemctl is UNKNOWN."

    # -------------------------------------------------------------------------
    def post_init(self):
        """Post initialization tasks."""
        super(CheckSystemdStatusPlugin, self).post_init()

        self.initialized = True

    # -------------------------------------------------------------------------
    def run(self):
        """Execute the main actions of the application."""
        LOG.debug("I'm walking, yes indeed, I'm walking....")

        cmd = "systemctl is-system-running"

        completed_process = self.execute(cmd, shell=True)

        system_status = str(completed_process.stdout).strip().lower()

        if system_status == "running":
            self.status = self.status_ok
        elif system_status in ("initializing", "starting", "maintenance", "degraded"):
            self.status = self.status_warning
        elif system_status in ("stopping", "offline"):
            self.status = self.status_critical
        else:
            self.status = self.status_unknown

        self.status_msg = (
            "According to systemd, the overall state of the system is [{}].".format(system_status) 
        )

        if self.status != self.status_ok:
            failed_units = []

            cmd = "systemctl list-units --failed --output=json"
            completed_process = self.execute(cmd, shell=True)

            failed_units = json.loads(completed_process.stdout)
            if self.verbose > 1:
                LOG.debug("Failed units:" + "\n" + pp(failed_units))

            if failed_units:
                first = failed_units[0]
                keys = []
                keys_uc = {}

                for key in first.keys():
                    keys.append(key)
                    keys_uc[key] = key.upper()

                self.status_msg += "\n" + self.get_table(keys, keys_uc, failed_units)
    

# =============================================================================

if __name__ == "__main__":
    plugin = CheckSystemdStatusPlugin()
    plugin()

